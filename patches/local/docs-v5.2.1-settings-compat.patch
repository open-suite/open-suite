diff --git a/helmfile/apps/docs/values.yaml.gotmpl b/helmfile/apps/docs/values.yaml.gotmpl
index 8995a63d6d460651cb9844fa5a7ae91dba6bdb15..a18ae4e82c92abdbbe17ac5b82b96ea489c7f6d9 100644
--- a/helmfile/apps/docs/values.yaml.gotmpl
+++ b/helmfile/apps/docs/values.yaml.gotmpl
@@ -214,6 +214,45 @@ backend:
     USER_OIDC_ESSENTIAL_CLAIMS: ""
     Y_PROVIDER_API_BASE_URL: "http://docs-y-provider:443/api/"
     Y_PROVIDER_API_KEY: {{ .Values.application.docs.yProvider.key | quote }}
+  # Docs v5.2.1's image defines the legacy READY_ONLY setting name while its
+  # title update path reads READ_ONLY. Apply upstream b01e6d5's one-line Python
+  # compatibility fix before starting Django; keep the deployed environment
+  # variable spelling unchanged.
+  initContainers:
+    - name: patch-collaboration-read-only-setting
+      image: {{ printf "%s/%s:%s" (coalesce .Values.container.docs.registry .Values.container.default.registry) .Values.container.docs.backend.repository .Values.container.docs.backend.tag | quote }}
+      imagePullPolicy: Always
+      command: ["/bin/sh", "-ec"]
+      args:
+        - |
+          source=/app/impress/settings.py
+          consumer=/app/core/api/viewsets.py
+          target=/opensuite-docs-settings/settings.py
+          test "$(grep -c '^    COLLABORATION_WS_NOT_CONNECTED_READY_ONLY = values.BooleanValue(' "${source}")" -eq 1
+          test "$(grep -c 'settings.COLLABORATION_WS_NOT_CONNECTED_READ_ONLY' "${consumer}")" -ge 1
+          cp "${source}" "${target}"
+          sed -i 's/^    COLLABORATION_WS_NOT_CONNECTED_READY_ONLY = values.BooleanValue(/    COLLABORATION_WS_NOT_CONNECTED_READ_ONLY = values.BooleanValue(/' "${target}"
+          test "$(grep -c '^    COLLABORATION_WS_NOT_CONNECTED_READ_ONLY = values.BooleanValue(' "${target}")" -eq 1
+          test "$(grep -c '^    COLLABORATION_WS_NOT_CONNECTED_READY_ONLY = values.BooleanValue(' "${target}")" -eq 0
+      securityContext:
+        runAsUser: 1001
+        runAsGroup: 1001
+        runAsNonRoot: true
+        readOnlyRootFilesystem: true
+        allowPrivilegeEscalation: false
+        capabilities: { drop: ["ALL"] }
+        seccompProfile: { type: RuntimeDefault }
+      volumeMounts:
+        - name: opensuite-docs-settings
+          mountPath: /opensuite-docs-settings
+  extraVolumes:
+    - name: opensuite-docs-settings
+      emptyDir: {}
+  extraVolumeMounts:
+    - name: opensuite-docs-settings
+      mountPath: /app/impress/settings.py
+      subPath: settings.py
+      readOnly: true
   themeCustomization:
     enabled: true
     fileContent: |
